{
  "expo": {
    "name": "Living Alcantara",
    "slug": "living-alcantara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-parco.png",
    "scheme": "alcatrails",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-parco.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "L'app necessita della tua posizione per mostrarti la tua posizione nella mappa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "L'app necessita della tua posizione in background per tracciare il percorso anche quando lo schermo è spento.",
        "NSLocationAlwaysUsageDescription": "L'app usa la tua posizione in background per monitorare la navigazione sui sentieri.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-parco.png",
        "backgroundImage": "./assets/images/logo-parco.png",
        "monochromeImage": "./assets/images/logo-parco.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.alcatrails"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-parco.png"
    },
    "plugins": [
      [
      
      "@rnmapbox/maps"
    
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Consenti ad Alcantara di accedere alle tue foto per aggiornare il profilo."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171819",
          "android": {
            "image": "./assets/images/logo-parco.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      "expo-image",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usiamo la tua posizione per mostrarti dove ti trovi rispetto ai percorsi del Parco.",
          "locationAlwaysAndWhenInUsePermission": "Usiamo la tua posizione anche in background durante il tracking per guidarti lungo il percorso e avvisarti quando raggiungi un punto di interesse."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84d6b040-2958-4a88-b78c-e3d4923eb866"
      }
    }
  }
}
